storage/screenshots/*.jpg
storage/screenshots/*.png
!storage/screenshots/.gitkeep
storage/data/*.db
storage/data/*.json
!storage/data/.gitkeep

# Operating system artifacts
Thumbs.db
Desktop.ini
.DS_Store
