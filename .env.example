# J.A.R.V.I.S. Environment Configuration Template
# Copy this file to .env and configure your secrets

PORT=4700
NODE_ENV=production

# Gemini AI Gateway
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
DEFAULT_MODEL=gemini-3.5-flash-lite
FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash

# Fish Audio TTS Engine
FISH_AUDIO_API_KEY=YOUR_FISH_AUDIO_API_KEY
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_VOICE_REF=05b36da8574341d0803391491850db20

# Personality & Safety
SYSTEM_PERSONALITY=butler
RISK_LEVEL_THRESHOLD=consequential
ENABLE_LOCAL_WAKE_WORD=true
WAKE_WORD=jarvis

# Vercel & Cloud Companion Bridge
JARVIS_COMPANION_URL=http://localhost:4700
NEXT_PUBLIC_API_URL=/api
